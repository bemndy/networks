#!/usr/bin/env python3

import socket
import argparse
import time
import subprocess
import sys
import random
import os
import hmac
import hashlib

HERE = os.path.dirname(os.path.abspath(__file__))

def parse_args():
    parser = argparse.ArgumentParser(description="UDP Full Client for CP1 Part 3")
    parser.add_argument("ip", type=str, help="IP address of the server")
    parser.add_argument("port", type=int, help="Port number of the server")
    parser.add_argument("id", type=str, help="Unique identifier for the worker")
    parser.add_argument("auth", type=str, help="Secret password for this worker ID")
    return parser.parse_args()

def sendto_helper(message, ip, port, s):
    print(f"Sending message: {message}")
    s.sendto(message.encode('utf-8'), (ip, port))
    data, _ = s.recvfrom(2048)
    return data.decode('utf-8').strip().split()

def authenticate_hash(ip, port, client_id, password, s):
    # Step 1: Request challenge nonce
    chal_resp = sendto_helper(f"AUTHREQ {client_id}", ip, port, s)
    if len(chal_resp) < 2 or chal_resp[0] != "CHALLENGE":
        print(f"Challenge failed: {' '.join(chal_resp)}")
        return None

    nonce = chal_resp[1]

    # Step 2: Compute HMAC-SHA256(password, nonce)
    digest = hmac.new(
        password.encode('utf-8'),
        nonce.encode('utf-8'),
        hashlib.sha256
    ).hexdigest()

    # Step 3: Send HELLO2 with HASH mode and computed digest
    hello_resp = sendto_helper(f"HELLO2 {client_id} HASH {digest}", ip, port, s)
    if len(hello_resp) >= 7 and hello_resp[0] == "RHELLO2" and hello_resp[1] == "OK":
        print(f"Authenticated successfully! Received: {' '.join(hello_resp)}")
        return hello_resp[6]
    else:
        print(f"Authentication failed: {' '.join(hello_resp)}")
        return None

def main():
    args = parse_args()

    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5.0)

    try:
        token = authenticate_hash(args.ip, args.port, args.id, args.auth, s)
        if not token:
            sys.exit(1)

        while True:
            # Send RDYTOSCAN request
            message = f"RDYTOSCAN {args.id} {token}"
            data = sendto_helper(message, args.ip, args.port, s)
            if len(data) >= 4 and data[0] == 'CLRTOSCAN' and data[1] == 'OK':
                print(f"Received: {' '.join(data)}")
            else:
                print(f"ERROR occurred with message: {data}")
                time.sleep(5)
                continue

            # Run cgrab for each file in scanset
            num_files = int(data[3])
            print(f"Number of files to grab: {num_files}")

            for i in range(num_files):
                filename = data[4 + i * 4]
                grab_ip = data[5 + i * 4]
                grab_port = data[6 + i * 4]
                auth_info = data[7 + i * 4]
                print(f"Running cgrab {filename} {grab_ip} {grab_port} {auth_info}")
                subprocess.run([os.path.join(HERE, "cgrab"), filename, grab_ip, grab_port, auth_info], cwd=HERE)

            time.sleep(random.uniform(15, 30))

    except socket.timeout:
        print("Error: UDP request timed out waiting for dispatch server.")
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nShutting down Full Client gracefully...")
        s.close()
        sys.exit(0)

if __name__ == "__main__":
    main()